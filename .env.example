# Dominio público que se imprime en los QR y se usa para armar las URLs.
# Cambialo por tu dominio real cuando lo tengas. Sin barra final.
DOMAIN=https://midominio.com

# Credenciales del panel de administración (un solo usuario admin)
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar-esta-clave

# Secreto usado para firmar la cookie de sesión del panel (string largo y random)
SESSION_SECRET=cambiar-por-un-string-random-largo

# Ruta del archivo de base de datos SQLite (persistente en el servidor/disco)
DB_PATH=./data/qr.db
